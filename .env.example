# Copy to .env and fill in whichever provider(s) you actually plan to use --
# see README.md's "Get API keys and configure .env" section for where to get
# each key and how each is used.

# Anthropic direct -- used when you run with --provider anthropic (the default)
ANTHROPIC_API_KEY=

# OpenRouter -- used when you run with --provider openrouter
OPENROUTER_API_KEY=
